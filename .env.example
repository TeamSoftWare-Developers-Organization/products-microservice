# ==============================================================================
# Cloudflare Infrastructure & Microservices Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare R2 (Object Storage for Images)
# ------------------------------------------------------------------------------
# In Cloudflare Dashboard -> R2 -> Create Bucket -> Create API Token (Admin Read/Write)
# S3_ENDPOINT format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_BUCKET_NAME=microshop-images
# Public URL / Custom Domain: e.g., https://pub-xxxxxxxx.r2.dev or https://images.microshop.ly
S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
S3_REGION=auto

# ------------------------------------------------------------------------------
# 2. Cloudflare Zero Trust Tunnel (Secure Ingress without Port Forwarding)
# ------------------------------------------------------------------------------
# In Cloudflare Zero Trust -> Networks -> Tunnels -> Create Tunnel -> Docker command token
CLOUDFLARE_TUNNEL_TOKEN=CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...your_cloudflare_tunnel_token...

# ------------------------------------------------------------------------------
# 3. Next.js Frontend (for Cloudflare Pages / Local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.microshop.ly
NEXT_PUBLIC_WS_URL=https://socket.microshop.ly
DATABASE_URL=postgresql://postgres:zafer4519932093@localhost:5432/auth_db
