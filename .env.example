# ---------- Core ----------
POSTGRES_PASSWORD=change_me_local_password
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Leave blank for local Docker/Podman. The browser will automatically use its current host on port 8085.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# ---------- Object storage ----------
# Local default = MinIO. Leave endpoint/keys blank to use the compose MinIO service.
S3_ENDPOINT=
S3_PORT=9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=products
S3_PUBLIC_URL=/uploads
S3_REGION=us-east-1
S3_USE_SSL=false
STORAGE_PUBLIC_READ=true

# Cloudflare R2 example (production only):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# S3_BUCKET_NAME=microshop-images
# S3_PUBLIC_URL=https://images.example.com
# S3_REGION=auto
# S3_USE_SSL=true

# ---------- Optional Cloudflare tunnel profile ----------
CLOUDFLARE_TUNNEL_TOKEN=

ADMIN_NAME=مدير النظام
